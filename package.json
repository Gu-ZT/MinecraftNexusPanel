{
  "name": "mcnp-workspace",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "api:lint": "redocly lint docs/api/openapi.yaml",
    "build": "pnpm --filter @mcnp/app build",
    "desktop:build": "node scripts/run-tauri.mjs apps/desktop build",
    "desktop:dev": "node scripts/run-tauri.mjs apps/desktop dev",
    "dev": "pnpm --filter @mcnp/app dev",
    "mobile:android": "node scripts/run-tauri.mjs apps/mobile android dev",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@redocly/cli": "2.41.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vue-tsc": "3.3.8"
  }
}
