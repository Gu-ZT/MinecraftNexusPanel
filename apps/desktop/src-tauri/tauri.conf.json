{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCNP Desktop",
  "version": "0.1.0",
  "identifier": "dev.mcnp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../frontend/app dev",
    "beforeBuildCommand": "pnpm --dir ../../frontend/app build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../frontend/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCNP",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true
  }
}
