{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCNP Desktop",
  "version": "0.1.0",
  "identifier": "dev.mcnp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../frontend/app dev",
    "beforeBuildCommand": "node ../../scripts/build-desktop.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../../frontend/app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCNP",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
