# Core mode requires an unpadded Base64URL secret with at least 32 random bytes.
MCNP_CORE_PSK=replace-with-a-generated-secret

# Panel and all modes require a separate 32-byte unpadded Base64URL key.
MCNP_PANEL_MASTER_KEY=replace-with-a-different-generated-key

# Optional runtime settings.
# MCNP_CORE_LISTEN=0.0.0.0:25580
# MCNP_CORE_TLS_CERT=/path/to/core-cert.pem
# MCNP_CORE_TLS_KEY=/path/to/core-key.pem
# MCNP_PANEL_LISTEN=127.0.0.1:8080
# MCNP_AUDIT_RETENTION_EVENTS=10000
# MCNP_INITIAL_ADMIN_USERNAME=admin
# MCNP_INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
# MCNP_DATA_DIR=data
# MCNP_LOG_FILTER=info
